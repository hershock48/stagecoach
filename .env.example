# The Stagecoach Inn — environment. Set these in the Vercel dashboard.
# This file is the authority on what the build needs; nothing here is a secret.

# ---------------------------------------------------------------------------
# Ordering (Jelly). REQUIRED for ordering to survive a page refresh: without a
# database, orders and menu edits live in one lambda's memory and vanish.
# Neon Postgres, added through the Vercel integration.
DATABASE_URL=

# The kitchen board PIN. Falls back to 0201 (the street number), which is a
# PLACEHOLDER and must not survive to go-live.
KITCHEN_PIN=

# Set to 1 while this is a pitch site so the order page demos outside kitchen
# hours. REMOVE AT GO-LIVE or the kitchen takes orders at 3am.
ORDERING_DEMO_ALWAYS_OPEN=

# Cloud printers, JSON array. Each entry: {"id","token","role","label"} where
# role is "kitchen" or "front". No printers configured means no print jobs; the
# board still chimes.
ORDERING_PRINTERS=

# ---------------------------------------------------------------------------
# Payments. Until these exist, checkout is demo mode and says so on screen.
# See the PAYMENT SEAM comment in app/api/ordering/order/route.ts.
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT=

# ---------------------------------------------------------------------------
# Mail. Sender is a verified glazedweb.com address so no client DNS work sits
# on the critical path; reply_to is set to the customer. With these unset the
# contact form falls back to a prefilled mailto and never claims to have sent
# anything.
RESEND_API_KEY=
INQUIRY_FROM=stagecoach@glazedweb.com
# PLACEHOLDER until the owner names the inbox a real person reads.
INQUIRY_TO=
